200b\u5927\u91cf\u200b\u5546\u52a1\u4eba\u58eb\u200b\u559c\u6b22\u200b\u4e0a\u200b\u4e86\u200b\u8fd9\u79cd\u200bPush email\u200b\u7684\u200b\u6982\u5ff5\u200b\u2026\u2026</p>"},{"location":"bbgushi/bbjieshao/%E9%BB%91%E8%8E%93blackberry%E6%89%8B%E6%9C%BA%E7%9A%84%E6%9D%A5%E7%94%B1/","title":"\u9ed1\u8393\u200bblackberry\u200b\u624b\u673a\u200b\u7684\u200b\u6765\u200b\u7531","text":"<p>BLACKBERRY\u200b\u662f\u200b\u52a0\u62ff\u5927\u200bRIM\u200b\u516c\u53f8\u200b\u63a8\u51fa\u200b\u7684\u200b\u4e00\u79cd\u200b\u79fb\u52a8\u200b\u7535\u5b50\u90ae\u4ef6\u7cfb\u7edf\u200b\u7ec8\u7aef\u200b\uff0c\u200b\u5176\u200b\u7279\u8272\u200b\u662f\u200b\u652f\u6301\u200b\u63a8\u52a8\u200b\u5f0f\u200b\u7535\u5b50\u90ae\u4ef6\u200b\u3001\u200b\u624b\u63d0\u200b\u7535\u8bdd\u200b\u3001\u200b\u6587\u5b57\u200b\u77ed\u4fe1\u200b\u3001\u200b\u4e92\u8054\u7f51\u200b\u4f20\u771f\u200b\u3001 \u200b\u7f51\u9875\u200b\u6d4f\u89c8\u200b\u53ca\u5176\u200b\u4ed6\u200b\u65e0\u7ebf\u200b\u8d44\u8baf\u200b\u670d\u52a1\u200b\u3002\u200b\u6280\u672f\u200b\u4e0a\u200b\u6765\u8bf4\u200b\uff0cBlackBerry\u200b\u662f\u200b\u4e00\u79cd\u200b\u91c7\u7528\u200b\u53cc\u5411\u200b\u5bfb\u547c\u200b\u6a21\u5f0f\u200b\u7684\u200b\u79fb\u52a8\u200b\u90ae\u4ef6\u7cfb\u7edf\u200b\uff0c\u200b\u517c\u5bb9\u200b\u73b0\u6709\u200b\u7684\u200b\u65e0\u7ebf\u200b\u6570\u636e\u94fe\u200b\u8def\u200b\u3002\u200b\u5b83\u200b\u51fa\u73b0\u200b\u4e8e\u200b1998\u200b\u5e74\u200b\uff0cRIM\u200b\u7684\u200b\u54c1\u724c\u6218\u7565\u200b\u987e\u95ee\u200b\u8ba4\u4e3a\u200b\uff0c\u200b\u65e0\u7ebf\u200b\u7535\u5b50\u90ae\u4ef6\u200b\u63a5\u6536\u5668\u200b\u6324\u200b\u5728\u200b\u4e00\u8d77\u200b\u7684\u200b\u5c0f\u5c0f\u7684\u200b\u6807\u51c6\u200b\u82f1\u6587\u200b\u9ed1\u8272\u200b\u952e\u76d8\u200b\uff0c\u200b\u770b\u8d77\u6765\u200b\u50cf\u662f\u200b\u8349\u8393\u200b\u8868\u9762\u200b\u7684\u200b\u4e00\u7c92\u200b\u7c92\u200b\u79cd\u5b50\u200b\uff0c\u200b\u5c31\u200b\u8d77\u200b\u4e86\u200b\u8fd9\u4e48\u200b\u4e00\u4e2a\u200b\u6709\u8da3\u200b\u7684\u200b\u540d\u5b57\u200b\u2026\u2026</p>"},{"location":"bbgushi/bblicheng/%E6%9C%80%E6%97%A9%E5%9C%A8%E4%B8%AD%E5%9B%BD%E6%B5%81%E8%A1%8C%E7%9A%84%E9%BB%91%E8%8E%93/","title":"\u6700\u65e9\u200b\u5728\u200b\u4e2d\u56fd\u200b\u6d41\u884c\u200b\u7684\u200b\u9ed1\u8393","text":"<p>\u200b\u9ed1\u8393\u200b\u624b\u673a\u200b\u578b\u53f7\u200b\u9887\u200b\u591a\u200b\uff0c\u200b\u4f46\u200b\u771f\u6b63\u200b\u5728\u200b\u56fd\u5185\u200b\u6d41\u884c\u200b\u7684\u200b\uff0c\u200b\u8981\u6570\u200b7230\u200b\u4e86\u200b\u3002Blackberry 7230/7290 \u200b\u7684\u200b\u5230\u6765\u200b\uff0c\u200b\u610f\u5473\u7740\u200b\u4e00\u4e2a\u200b\u5145\u6ee1\u200b\u7740\u200b\u8272\u5f69\u200b\u7684\u200b\u7535\u5b50\u200b\u65f6\u4ee3\u200b\u6765\u4e34\u200b\u3002\u200b\u867d\u7136\u200b\u662f\u200b6\u200b\u4e07\u200b5\u200b\u5343\u8272\u200b\uff0c\u200b\u4f46\u662f\u200b\u5374\u200b\u8de8\u8fdb\u200b\u4e86\u200b\u65b0\u200b\u65f6\u4ee3\u200b\uff0c\u200b\u6210\u4e3a\u200b\u4e86\u200b\u4e00\u4ee3\u200b\u7ecf\u5178\u200b\u30027230\u200b\u4e0e\u200b7290\u200b\u7684\u200b\u533a\u522b\u200b\u4e3b\u8981\u200b\u662f\u200b\u5185\u5b58\u200b\u7684\u200b\u5927\u5c0f\u200b\uff0c\u200b\u5206\u522b\u200b\u662f\u200b16M\u200b\u548c\u200b32M\uff0c\u200b\u8fd9\u200b\u4e24\u6b3e\u200b\u624b\u673a\u200b\u4e5f\u200b\u662f\u200b\u5728\u200b\u4e2d\u56fd\u200b\u5e02\u573a\u200b\u5185\u200b\u6700\u4f4e\u200b\u7aef\u7684\u200b\u9ed1\u8393\u200b\u624b\u673a\u200b\uff0c\u200b\u4f46\u200b\u4e5f\u200b\u662f\u200b\u6700\u200b\u6d41\u884c\u200b\u7684\u200b\u3002</p>"},{"location":"bbgushi/bblicheng/%E9%BB%91%E8%8E%93%E8%81%94%E5%A7%BB%E4%B8%AD%E5%9B%BD%E7%A7%BB%E5%8A%A8%E9%A6%96%E5%85%A5%E4%B8%AA%E4%BA%BA%E5%B8%82%E5%9C%BA/","title":"\u9ed1\u8393\u200b\u8054\u59fb\u200b\u4e2d\u56fd\u79fb\u52a8\u200b\u9996\u5165\u200b\u4e2a\u4eba\u200b\u5e02\u573a","text":"<p>2009\u200b\u5e74\u200b12\u200b\u6708\u200b8\u200b\u65e5\u200b\uff0cRIM\u200b\u516c\u53f8\u200b\u8054\u5e2d\u200bCEO\u200b\u4e0e\u200b\u4e2d\u56fd\u79fb\u52a8\u200b\u8463\u4e8b\u957f\u200b\u738b\u5efa\u5b99\u200b\u4e00\u8d77\u200b\u5ba3\u5e03\u200b\u53cc\u65b9\u200b\u65b0\u200b\u7684\u200b\u6218\u7565\u200b\u5408\u4f5c\u200b\uff1aRIM\u200b\u5c06\u200b\u63a8\u51fa\u200bTD\u200b\u7248\u200b\u9ed1\u8393\u200b\u624b\u673a\u200b\uff0c\u200b\u4e2d\u56fd\u79fb\u52a8\u200b\u5c06\u200b\u628a\u200b\u9ed1\u8393\u200b\u624b\u673a\u200b\u63a8\u5e7f\u200b\u5230\u200b\u4e2a\u4eba\u200b\u3002\u200b\u65e9\u200b\u5728\u200b2006\u200b\u5e74\u200b\u4e2d\u56fd\u79fb\u52a8\u200b\u5c31\u200b\u4e0e\u200bRIM\u200b\u516c\u53f8\u200b\u5728\u200b\u4f01\u4e1a\u200b\u5e02\u573a\u200b\u4e0a\u200b\u8fdb\u884c\u200b\u4e86\u200b\u5408\u4f5c\u200b\uff0c\u200b\u4e0d\u8fc7\u200b\uff0c\u200b\u8be5\u200b\u4e1a\u52a1\u200b\u4e3b\u8981\u200b\u9762\u5411\u200b\u5b9d\u94a2\u96c6\u56e2\u200b\u3001\u200b\u4e2d\u56fd\u200b\u56fd\u9645\u91d1\u878d\u516c\u53f8\u200b\u7b49\u200b\u5927\u578b\u200b\u96c6\u56e2\u200b\u5ba2\u6237\u200b\uff0c\u200b\u4e2a\u4eba\u200b\u662f\u200b\u65e0\u6cd5\u200b\u8d2d\u4e70\u200b\u5230\u200b\u79fb\u52a8\u200b\u7684\u200b\u9ed1\u8393\u200b\u624b\u673a\u200b\u3002</p>"},{"location":"bbruanjian/","title":"\u7b80\u4ecb","text":"<p>\u200b\u70ed\u95e8\u200b\u6742\u5fd7\u200b</p>"},{"location":"bbruanjian/yingyong/1/","title":"\u7b80\u4ecb","text":"<p>\u200b\u70ed\u95e8\u200b\u6742\u5fd7\u200b</p>"},{"location":"bbruanjian/youxi/1/","title":"\u7b80\u4ecb","text":"<p>\u200b\u70ed\u95e8\u200b\u6742\u5fd7\u200b</p>"},{"location":"","title":"\u9ed1\u8393\u200b\u6000\u5ff5\u200b\u5206\u4eab\u200b\u7f51","text":"<p>\u200b\u6000\u5ff5\u200b\u9ed1\u8393\u200b\u624b\u673a\u200b</p> <p>Hi there~ \u200b\u6b22\u8fce\u200b\u6765\u5230\u200b\u6211\u200b\u7684\u200b\u9ed1\u8393\u200b\u624b\u673a\u200b\u77e5\u8bc6\u5e93\u200b\u3002</p> <p>\u200b\u4e3a\u4e86\u200b\u907f\u514d\u200b\u9057\u5fd8\u200b\u3001\u200b\u4fbf\u4e8e\u200b\u5206\u4eab\u200b\uff0c\u200b\u6211\u200b\u5728\u200b\u8fd9\u91cc\u200b\u6536\u5f55\u200b\u77e5\u8bc6\u200b\u3002 \u200b\u8bf7\u200b\u968f\u610f\u200b\u6d4f\u89c8\u200b\uff5e</p> <p>\u200b\u70ed\u95e8\u200b &amp; \u200b\u6742\u5fd7\u200b \u200b\u793e\u4f1a\u200b &amp; \u200b\u79d1\u5b66\u200b \u200b\u81ea\u7136\u200b &amp; \u200b\u79d1\u5b66\u200b</p>"}]}